    // Object storage / CDN that hosts the encoded videos and posters, no trailing slash.
    // Relative media paths stored in the DB are resolved against this.
    'CDN_BASE_URL' => 'https://cdn.example.com',

    // Output of password_hash(). Placeholder below never verifies.
    'ADMIN_PASSWORD_HASH' => 'REPLACE_WITH_PASSWORD_HASH',

    // Sticky call-to-action button.
    'CTA_URL' => 'https://example.com/contact',
    'CTA_LABEL' => 'سفارش پروژه',

    'SITE_NAME' => 'آژانس خلاقیت آواجار',

    // SQLite file. Must stay outside public/ and be writable by PHP (folder too).
    'DB_PATH' => __DIR__ . '/data/avajar.sqlite',
];
