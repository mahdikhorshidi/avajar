/**
 * Copy this file to config.php (same folder) and fill in real values.
 * config.php is git-ignored and denied by .htaccess. Never commit it.
 *
 * Generate ADMIN_PASSWORD_HASH on your own machine:
 *   php -r 'echo password_hash("your-password", PASSWORD_DEFAULT), PHP_EOL;'
 */
return [
    // Public site address, no trailing slash. Used for canonical and OG URLs.
